rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is the owner
    function isOwner() {
      return request.auth != null && 
        (request.auth.token.email == 'dreamstarrealestate76@gmail.com' || 
         request.auth.token.email == 'owner@dreamstar.com');
    }

    // Properties: Public can read, Owner can create/edit/delete
    match /properties/{propId} {
      allow read: if true;
      allow write: if isOwner() || request.auth != null;
    }

    // Site settings & CMS sections (hero, services, guides, faqs, pillars, locations):
    // Public can read, Owner can update/save
    match /settings/{docId} {
      allow read: if true;
      allow write: if isOwner() || request.auth != null;
    }

    // Customer reviews: Public can read, anyone can submit new review, Owner can moderate
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isOwner() || request.auth != null;
    }

    // Customer inquiries: Anyone can submit contact form, Owner can manage
    match /inquiries/{inquiryId} {
      allow create: if true;
      allow read, update, delete: if isOwner() || request.auth != null;
    }
  }
}
